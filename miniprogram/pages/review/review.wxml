<view class="container">
  <view wx:if="{{stats}}" class="card">
    <view class="row-between">
      <view class="card-title no-margin">今日复习</view>
      <view class="muted small">{{stats.progressText}}</view>
    </view>
    <view class="progress mt12">
      <view class="progress-inner" style="width:{{stats.percent}}%"></view>
    </view>
    <view class="stat-grid">
      <view class="stat">
        <view class="stat-num">{{stats.dueNow}}</view>
        <view class="stat-label">到期</view>
      </view>
      <view class="stat">
        <view class="stat-num">{{stats.dueTomorrow}}</view>
        <view class="stat-label">明日到期</view>
      </view>
      <view class="stat">
        <view class="stat-num">{{stats.reviewing}}</view>
        <view class="stat-label">复习中</view>
      </view>
      <view class="stat">
        <view class="stat-num">{{stats.mastered}}</view>
        <view class="stat-label">已掌握</view>
      </view>
      <view class="stat">
        <view class="stat-num">{{stats.retentionText}}</view>
        <view class="stat-label">7 天保持率</view>
      </view>
    </view>
  </view>

  <view wx:if="{{error}}" class="error-tip">{{error}}</view>

  <block wx:if="{{phase === 'idle'}}">
    <view class="card">
      <view class="muted small">
        <block wx:if="{{stats && stats.dueNow > 0}}">现在有 {{stats.dueNow}} 个词到期，先复习最该复习的。</block>
        <block wx:else>当前没有到期的词。也可以加练几轮——队列空了会提示你。</block>
      </view>
      <button class="btn btn-primary mt16" loading="{{loading}}" disabled="{{loading}}" bindtap="onTapStart">
        开始复习（最多 20 张）
      </button>
    </view>
  </block>

  <block wx:elif="{{phase === 'card'}}">
    <view class="card">
      <view class="row-between small muted">
        <text>第 {{index + 1}} / {{queue.length}} 张</text>
        <text class="type-tag">{{modeLabel}}</text>
      </view>
      <view class="divider"></view>

      <!-- 题干：有释义/挖空句就出题；SELF 没有题干，直接亮词面自评（不出空卡） -->
      <view wx:if="{{stem}}" class="prompt {{stemCloze ? 'cloze' : ''}}">{{stem}}</view>

      <view wx:if="{{card.encounterCount}}" class="small muted tip-line">
        在阅读中遇见过 {{card.encounterCount}} 次
      </view>

      <view wx:if="{{mode === 'CHOOSE'}}" class="choices">
        <view
          wx:for="{{card.choices}}"
          wx:key="*this"
          class="choice {{revealed && item === card.answer ? 'choice-right' : ''}} {{revealed && item === chosen && chosen !== card.answer ? 'choice-wrong' : ''}}"
          data-choice="{{item}}"
          bindtap="onChoiceTap"
        >
          {{item}}
        </view>
      </view>

      <view wx:if="{{mode === 'SPELL' && !revealed}}" class="spell-row">
        <input
          class="field-inline"
          type="text"
          placeholder="按释义拼出这个词"
          value="{{spellInput}}"
          bindinput="onSpellInput"
          bindconfirm="onSpellCheck"
        />
        <view class="btn btn-primary btn-small" bindtap="onSpellCheck">检查</view>
      </view>

      <!-- 想不起来也得走得掉：拼写与回忆都给「揭示答案」这条退路 -->
      <button
        wx:if="{{!revealed && (mode === 'RECALL' || mode === 'SPELL')}}"
        class="btn btn-ghost mt16"
        bindtap="onReveal"
      >
        揭示答案
      </button>

      <!-- 词面：SELF 一开始就亮；其余题型揭示后才亮（释义是题干，词面即答案） -->
      <view wx:if="{{mode === 'SELF' || revealed}}" class="answer">
        <view class="answer-word">{{card.word}}</view>
        <view wx:if="{{spellCorrect === false}}" class="small wrong">拼写不一致，正确答案见上方</view>
        <view wx:if="{{card.answerNote}}" class="small muted mt8">{{card.answerNote}}</view>
      </view>

      <!-- 语境原句含目标词，揭示前不渲染（R137 泄题门控），SELF 无题干可直接给 -->
      <view wx:if="{{card.contextSentence && (revealed || mode === 'SELF')}}" class="context">
        <view class="context-text">{{card.contextSentence}}</view>
        <view class="small muted">{{card.contextBook}} {{card.contextChapter}}</view>
      </view>

      <block wx:if="{{revealed || mode === 'SELF'}}">
        <view class="small muted mt16">这次记得怎么样？答案的诚实程度决定下次出现的时间。</view>
        <view class="grade-row">
          <view
            wx:for="{{grades}}"
            wx:key="grade"
            class="grade grade-{{item.grade}}"
            data-grade="{{item.grade}}"
            bindtap="onGradeTap"
          >
            <view class="grade-label">{{item.label}}</view>
            <view class="grade-hint">{{item.hint}}</view>
          </view>
        </view>
      </block>
    </view>

    <view class="center small muted exit" bindtap="onExit">结束本轮</view>
  </block>

  <block wx:else>
    <view class="card center">
      <view class="done-title">本轮复习完成</view>
      <view class="muted small">
        本次作答 {{answered}} 张<block wx:if="{{stats}}"> · 今日 {{stats.progressText}}</block>
      </view>
      <button class="btn btn-primary mt16" loading="{{loading}}" disabled="{{loading}}" bindtap="onTapStart">
        继续加练
      </button>
    </view>
  </block>
</view>
