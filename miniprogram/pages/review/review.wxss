.no-margin {
  margin-bottom: 0;
}

.mt12 {
  margin-top: 12rpx;
}

.mt16 {
  margin-top: 16rpx;
}

.mt8 {
  margin-top: 8rpx;
}

.stat-grid {
  display: flex;
  margin-top: 20rpx;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 34rpx;
  font-weight: 600;
}

.stat-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.type-tag {
  background: var(--primary-soft);
  color: var(--primary);
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.prompt {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.6;
  padding: 10rpx 0 6rpx;
}

.cloze {
  font-weight: 400;
  color: #4b5058;
}

.tip-line {
  margin-top: 8rpx;
}

.context {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  background: #f7f8fa;
  border-radius: 14rpx;
}

.context-text {
  font-size: 26rpx;
  color: #4b5058;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.choices {
  margin-top: 22rpx;
}

.choice {
  padding: 24rpx 26rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  font-size: 30rpx;
  background: #fff;
}

.choice-right {
  border-color: var(--success);
  background: var(--success-soft);
  color: var(--success);
}

.choice-wrong {
  border-color: var(--danger);
  background: var(--danger-soft);
  color: var(--danger);
}

.spell-row {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.field-inline {
  flex: 1;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 20rpx 22rpx;
  font-size: 30rpx;
}

.btn-small {
  width: 150rpx;
  margin-left: 16rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
}

.answer {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed var(--line);
}

.answer-word {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.wrong {
  color: var(--danger);
  margin-top: 8rpx;
}

.grade-row {
  display: flex;
  margin-top: 16rpx;
}

.grade {
  flex: 1;
  margin-right: 12rpx;
  padding: 18rpx 0;
  text-align: center;
  border-radius: 14rpx;
  background: #f2f3f5;
}

.grade:last-child {
  margin-right: 0;
}

.grade-label {
  font-size: 28rpx;
  font-weight: 600;
}

.grade-hint {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.grade-1 {
  background: var(--danger-soft);
  color: var(--danger);
}

.grade-2 {
  background: var(--warn-soft);
  color: var(--warn);
}

.grade-3 {
  background: var(--primary-soft);
  color: var(--primary);
}

.grade-4 {
  background: var(--success-soft);
  color: var(--success);
}

.done-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.exit {
  padding: 20rpx;
}
