.brand {
  padding: 60rpx 8rpx 40rpx;
}

.brand-title {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.brand-sub {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 26rpx;
}

.field {
  width: 100%;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  font-size: 30rpx;
  background: #fff;
}

.tip {
  margin-top: 18rpx;
  line-height: 1.6;
}

.foot {
  margin-top: 24rpx;
  text-align: center;
}

.mt {
  margin-top: 16rpx;
}

.link {
  color: var(--primary);
}
