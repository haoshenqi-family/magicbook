<view class="container">
  <view class="brand">
    <view class="brand-title">MagicBook 工具</view>
    <view class="brand-sub">AI 伴读 · 每日复习 · 词汇量测试 · 学习数据</view>
  </view>

  <view wx:if="{{error}}" class="error-tip">{{error}}</view>

  <!-- 主入口：没有账号也能进 -->
  <block wx:if="{{phase === 'idle'}}">
    <view class="card">
      <button class="btn btn-primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onTapLogin">
        微信一键登录
      </button>
      <view class="small muted tip">
        第一次使用会为你创建一个微信账号，直接用即可。之后在「账号」页绑定邮箱，
        即可与网页端的学习记录合并成同一个账号。
      </view>
      <view class="divider"></view>
      <button class="btn btn-ghost" disabled="{{loading}}" bindtap="onTapEmailLogin">
        我已有账号，用邮箱登录
      </button>
      <view class="small muted tip">
        不用输密码：填网页端账号的邮箱，收一次验证码就能登进去，并把当前微信绑到该账号。
      </view>
    </view>
    <view class="small muted foot">阅读在网页端进行，登录后在「我」页可复制主站链接</view>
  </block>

  <!-- 邮箱登录：填邮箱 -->
  <block wx:elif="{{phase === 'email'}}">
    <view class="card">
      <view class="card-title">用邮箱登录已有账号</view>
      <view class="small muted tip">
        填网页端账号使用的邮箱。验证通过后，当前微信会自动绑到那个账号，不会新建账号。
      </view>

      <input
        class="field"
        type="text"
        placeholder="你的邮箱"
        placeholder-class="field-ph"
        value="{{email}}"
        bindinput="onEmailInput"
      />

      <button class="btn btn-primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onSendCode">
        发送验证码
      </button>
      <button class="btn btn-ghost mt" bindtap="onCancelEmail">返回</button>

      <view class="small muted tip">本次登录凭据 {{expiresIn}} 秒内有效，超时请返回重新点击。</view>
    </view>
  </block>

  <!-- 邮箱登录：填验证码 -->
  <block wx:else>
    <view class="card">
      <view class="card-title">输入验证码</view>
      <view class="small muted tip">
        验证码已发送至 <text class="em">{{email}}</text>，10 分钟内有效。
      </view>

      <input
        class="field field-code"
        type="number"
        maxlength="6"
        placeholder="6 位数字"
        placeholder-class="field-ph"
        value="{{code}}"
        bindinput="onCodeInput"
      />

      <button class="btn btn-primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onVerify">
        验证并登录
      </button>
      <view class="row-between resend-row">
        <view class="small muted">没收到？检查垃圾邮件</view>
        <view class="small resend {{countdown > 0 ? 'resend-wait' : 'resend-ready'}}" bindtap="onSendCode">
          {{countdown > 0 ? countdown + ' 秒后重发' : '重新发送'}}
        </view>
      </view>
      <button class="btn btn-ghost mt" bindtap="onCancelEmail">返回</button>
    </view>
  </block>
</view>
