.who {
  font-size: 34rpx;
  font-weight: 600;
}

.field {
  width: 100%;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  font-size: 30rpx;
  background: #fff;
}

.field[disabled] {
  background: #f7f8fa;
  color: var(--muted);
}

.tip {
  margin-top: 16rpx;
  line-height: 1.6;
}

.mt {
  margin-top: 16rpx;
}

.mt8 {
  margin-top: 8rpx;
}

.link {
  color: var(--primary);
}

.foot {
  margin-top: 24rpx;
  text-align: center;
}
