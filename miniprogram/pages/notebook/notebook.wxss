.search-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.search {
  flex: 1;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
}

.clear {
  margin-left: 16rpx;
  color: var(--primary);
  font-size: 26rpx;
}

.item {
  padding: 22rpx 24rpx;
}

.word {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  max-width: 70%;
}

.meaning {
  margin-top: 8rpx;
  color: #4b5058;
  font-size: 27rpx;
  line-height: 1.5;
}

.meta {
  margin-top: 12rpx;
  font-size: 23rpx;
}

.dot {
  margin: 0 10rpx;
}

/* 临时账号提示条：不占整块卡片，避免把首屏的词往下推 */
.shadow-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  background: var(--warn-soft);
  color: var(--warn);
}

.shadow-link {
  color: var(--primary);
  flex: none;
  margin-left: 16rpx;
}
