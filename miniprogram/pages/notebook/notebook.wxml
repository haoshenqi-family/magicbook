<view class="container">
  <view class="search-row">
    <input
      class="search"
      type="text"
      placeholder="搜索单词前缀"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onKeywordInput"
      bindconfirm="onSearchConfirm"
    />
    <view wx:if="{{keyword}}" class="clear" bindtap="onClearKeyword">清除</view>
  </view>

  <view class="chips">
    <view
      wx:for="{{filters}}"
      wx:key="key"
      class="chip {{filter === item.key ? 'chip-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onFilterTap"
    >
      {{item.label}} {{counts[item.key]}}
    </view>
  </view>

  <view wx:if="{{error}}" class="error-tip" bindtap="reload">{{error}}（点此重试）</view>

  <view wx:if="{{!items.length && !loading}}" class="empty">
    <block wx:if="{{filter === 'all' && !keyword}}">生词本还是空的。在网页端阅读时标记生词，这里会自动同步。</block>
    <block wx:elif="{{keyword}}">没有以「{{keyword}}」开头的词</block>
    <block wx:else>这个分类下暂无单词</block>
  </view>

  <view
    wx:for="{{items}}"
    wx:key="word"
    class="card item"
    data-word="{{item.word}}"
    bindtap="onItemTap"
  >
    <view class="row-between">
      <view class="word ellipsis">{{item.word}}</view>
      <view class="tag tag-{{item.status}}">{{item.statusText}}</view>
    </view>
    <view class="meaning">{{item.meaning || '暂无释义（在网页端查过这个词后自动补全）'}}</view>
    <view class="row small muted meta">
      <text>{{item.sourceText}}</text>
      <text class="dot">·</text>
      <text>{{item.encounterText}}</text>
      <text wx:if="{{item.lastText}}" class="dot">·</text>
      <text wx:if="{{item.lastText}}">{{item.lastText}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="load-more">加载中…</view>
  <view wx:elif="{{hasNext}}" class="load-more">上滑加载更多（共 {{total}} 个）</view>
  <view wx:elif="{{items.length}}" class="load-more">已到底部，共 {{total}} 个</view>
</view>
