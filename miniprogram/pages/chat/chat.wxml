<view class="chat-page">
  <view class="chat-head">
    <view class="grow">
      <view class="chat-title">AI 伴读</view>
      <view class="small muted">通用对话 · 不在书里也能聊</view>
    </view>
    <view class="new-chat" bindtap="onNewChat">新会话</view>
  </view>

  <scroll-view class="chat-scroll" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation>
    <view class="chat-list">
      <view wx:if="{{!messages.length}}" class="welcome card">
        <view class="welcome-title">聊聊英语，或者随便问点什么</view>
        <view class="small muted mt8">这里没有书和网页上下文，伙伴会按通用对话回答。</view>
        <view class="suggestions">
          <view
            wx:for="{{suggestions}}"
            wx:key="*this"
            class="suggestion"
            data-text="{{item}}"
            bindtap="onTapSuggestion"
          >{{item}}</view>
        </view>
      </view>

      <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="msg msg-{{item.role}}">
        <view class="bubble">
          <block wx:if="{{item.content}}">
            <text user-select>{{item.content}}</text>
            <text wx:if="{{item.status === 'streaming'}}" class="caret">▍</text>
          </block>
          <text wx:elif="{{item.status === 'tool'}}">正在查证…</text>
          <text wx:elif="{{item.status === 'thinking'}}">正在思考…</text>
          <text wx:elif="{{item.status === 'error'}}" class="error-text">{{item.error}}</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{error}}" class="chat-error">{{error}}</view>

  <view class="composer">
    <input
      class="composer-input"
      value="{{input}}"
      placeholder="问点什么…"
      placeholder-class="composer-ph"
      confirm-type="send"
      bindconfirm="onSend"
      bindinput="onInput"
      cursor-spacing="16"
      maxlength="1000"
    />
    <button class="send {{sending ? 'send-wait' : ''}}" bindtap="onSend" disabled="{{sending}}">
      {{sending ? '…' : '发送'}}
    </button>
  </view>
</view>
