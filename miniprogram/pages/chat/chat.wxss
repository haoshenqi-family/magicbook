/**
 * AI 伴读对话页样式。
 * Why 用 flex 三段（头 / scroll-view / 输入栏）而不是 fixed 定位：小程序键盘弹起时
 * webview 高度会变，fixed 元素常被顶飞或盖住输入框；flex + cursor-spacing 更稳。
 */
.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.chat-head {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--line);
}

.chat-title {
  font-size: 32rpx;
  font-weight: 600;
}

.new-chat {
  flex: none;
  margin-left: 16rpx;
  padding: 10rpx 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  color: var(--primary);
  font-size: 26rpx;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
}

.chat-list {
  padding: 24rpx 24rpx 32rpx;
}

.welcome-title {
  font-size: 30rpx;
  font-weight: 600;
}

.suggestions {
  margin-top: 20rpx;
}

.suggestion {
  display: inline-block;
  margin: 0 12rpx 12rpx 0;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 26rpx;
}

.msg {
  display: flex;
  margin-bottom: 20rpx;
}

.msg-user {
  justify-content: flex-end;
}

.msg-assistant {
  justify-content: flex-start;
}

.bubble {
  max-width: 78%;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.msg-user .bubble {
  background: var(--primary);
  color: #fff;
  border-bottom-right-radius: 6rpx;
}

.msg-assistant .bubble {
  background: #fff;
  color: var(--text);
  border-bottom-left-radius: 6rpx;
}

.caret {
  color: var(--primary);
}

.error-text {
  color: var(--danger);
}

.chat-error {
  padding: 10rpx 24rpx;
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 24rpx;
}

.composer {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid var(--line);
}

.composer-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 38rpx;
  background: var(--bg);
  font-size: 28rpx;
}

.composer-ph {
  color: #b7bcc4;
}

.send {
  flex: none;
  width: 120rpx;
  height: 76rpx;
  margin-left: 16rpx;
  padding: 0;
  border-radius: 38rpx;
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
  line-height: 76rpx;
  text-align: center;
}

.send::after {
  border: none;
}

.send-wait {
  opacity: 0.6;
}
