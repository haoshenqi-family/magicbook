# Calibre-Web AI 伴读版 部署环境变量
# 复制此文件为 .env 并按需修改

# ========== ACR 镜像仓库凭据 ==========
# deploy.sh 自动登录阿里云容器镜像服务（registry.cn-hangzhou.aliyuncs.com）
ACR_USERNAME=
ACR_PASSWORD=
# docker 凭据目录（默认 /etc/docker-acr，避免被 fnOS 面板清掉登录态）
# ACR_DOCKER_CONFIG=/etc/docker-acr

# ========== 端口 ==========
# 宿主机暴露端口（容器内固定 8083）
CALIBRE_PORT=8083

# ========== 数据卷路径 ==========
# Calibre 书库目录（宿主机路径，必须包含 metadata.db）
# 例如：/home/user/calibre-library 或 ./calibre-library
CALIBRE_LIBRARY_PATH=./calibre-library

# 应用配置目录（app.db、settings.yaml、gdrive 凭据等）
CONFIG_PATH=./config

# 日志目录（可选）
LOG_PATH=./logs

# ========== 高级选项（可选） ==========
# 启用公共数据库重连路由 /reconnect（0/1）
CALIBRE_CONFIG_RECONNECT=0

# ========== 元数据搜索外呼（可选） ==========
# 仅谷歌相关请求（googleapis.com / books.google.com / scholar.google.com 等）
# 走此代理，其余元数据源（豆瓣/Amazon/ComicVine/LubimyCzytac）始终保持直连；
# 留空则谷歌请求也直连（仅在内网本身可达谷歌时可用）。
METADATA_GOOGLE_PROXY=
# 元数据搜索整体等待上限（秒）。搜索视图运行在事件循环线程，此值即全站
# 可用性上限；超时的元数据源被丢弃，已拿到的结果照常返回。
METADATA_SEARCH_TIMEOUT=60

# ========== AI Reading Companion 独立数据源（可选，不填则用本地 SQLite） ==========
# 仅 AI 会话/消息/记忆使用此数据库；Calibre 书库与用户体系仍用 SQLite。
# 格式：mysql+pymysql://<用户>:<密码>@<主机>:<端口>/<库名>?charset=utf8mb4
# 复制为 .env 后填写真实值（.env 已被 gitignore，不会提交）。
# 注意：目标库必须以 utf8mb4 建库（见 docs/feat/ai-reading-companion/sql/create_ai_database.sql），
#       首次启动会自动将旧 app.db 中的 ai_* 数据迁入。
# AI_DATABASE_URL=mysql+pymysql://user:password@192.168.31.9:3306/ai_companion?charset=utf8mb4
# moon-well 内网地址
MOON_WELL_READING_URL=

# ========== 日志接入 Elasticsearch（filebeat sidecar） ==========
# 采集配置目录中的 calibre-web.log / access.log 写入 ES 索引 app-log-magicbook
# 索引模板与 30 天保留策略见 deploy/init-app-log-es.sh
LOG_ES_HOSTS=https://es.haoshenqi.top:443
LOG_ES_USERNAME=elastic
LOG_ES_PASSWORD=
# 镜像拉取慢时可覆盖为国内镜像地址
# FILEBEAT_IMAGE=docker.elastic.co/beats/filebeat:8.11.3

# ========== Authentik 统一登录（OIDC） ==========
# 三项齐全时启用：登录页隐藏本地密码表单，仅保留「Log in with Authentik」
AUTHENTIK_ISSUER=https://authentik.haoshenqi.top/application/o/magicbook/
AUTHENTIK_MAGICBOOK_CLIENT_ID=
AUTHENTIK_MAGICBOOK_CLIENT_SECRET=
# 回调地址，需与 Authentik application 的 Redirect URLs 白名单一致
AUTHENTIK_MAGICBOOK_REDIRECT_URI=https://magicbook.haoyuhang.top/oidc/callback
# 邀请制注册入口（R103）：Authentik enrollment 邀请链接，配置后登录页渲染
# 「注册账号 Sign up (invite)」按钮；邀请默认 30 天过期，轮换时更新此值并重启
AUTHENTIK_ENROLLMENT_INVITE_URL=

# ========== 会话持久化（R123） ==========
# 登录会话 cookie 有效期（天）：moon-well token 存于该会话内，浏览器重启后仍存活；
# 每次访问滑动续期，连续 30 天不用才需重登。默认 30。
#SESSION_PERMANENT_DAYS=30
