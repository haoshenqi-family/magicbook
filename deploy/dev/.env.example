# =============================================================
# magicbook FNOS **dev 测试环境**部署环境变量（R288，2026-11-07）
# 落地：fnOS /app/magicbook-dev/.env —— 从生产 /app/magicbook/.env 复制后改差异项，
#       不要从本示例从零填（OIDC issuer/client、MOONWELL_SYSTEM_TOKEN、MinIO 凭据与生产同值）。
# =============================================================

# ACR 登录（deploy.sh 用，与生产同值）
ACR_USERNAME=your-acr-username
ACR_PASSWORD=your-acr-password
ACR_DOCKER_CONFIG=/etc/docker-acr

# —— 路径三件套（dev 独立目录；compose.yaml 有同款默认值，.env 显式写全以防漂移）——
# 书库：共享生产书库（dev 只读姿态，勿做元数据编辑/投稿入库测试）
# ⚠️ 生产真值 /app/magicbook/library（2026-11-07 实测修正，旧文档口径 calibre-library 是空壳）
CALIBRE_LIBRARY_PATH=/app/magicbook/library
# 独立应用配置目录（app.db 复制自生产；端口/会话/调度分离的硬前提）
CONFIG_PATH=/app/magicbook-dev/config
LOG_PATH=/app/magicbook-dev/logs

# —— 与生产的关键差异 ——

# moon-well 指向 **dev moon-well**（fnOS 8084；生产为 http://fnos:8082）
MOON_WELL_READING_URL=http://fnos:8084

# OIDC：issuer / client_id / client_secret 与生产同值（同一 Authentik provider，账号互通）；
# redirect 指向 dev 域（Authentik 应用白名单已加该条，2026-11-07）
AUTHENTIK_MAGICBOOK_REDIRECT_URI=https://dev-magicbook.haoshenqi.top/oidc/callback

# AI 会话库：**留空** → 回落本地 SQLite（ai_companion.db 落 dev config 目录，与生产隔离）
# AI_DATABASE_URL=

# —— 与生产同值（复制生产 .env 即得）——
# AUTHENTIK_ISSUER / AUTHENTIK_MAGICBOOK_CLIENT_ID / AUTHENTIK_MAGICBOOK_CLIENT_SECRET
# MOONWELL_SYSTEM_TOKEN（mk- 系统令牌）
# AUTHENTIK_ENROLLMENT_INVITE_URL（与域名无关，原样复用）
# METADATA_GOOGLE_PROXY / METADATA_SEARCH_TIMEOUT
# LOG_ES_*（dev 无 filebeat，留不留都不生效）
