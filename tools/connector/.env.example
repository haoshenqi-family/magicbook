# halo-book-connector 环境变量（fnOS /vol1/1000/app/halo-book-connector/.env）
# 入站鉴权：Halo webhook 插件 Request Headers 里 X-Hook-Token 的同值密钥
CONNECTOR_HOOK_TOKEN=change-me-random-64-hex
# 出站鉴权：magicbook .env 中 BOOK_IMPORT_KEY 的同值密钥
BOOK_IMPORT_KEY=change-me-shared-with-magicbook
HALO_BASE_URL=https://note.haoshenqi.top
MAGICBOOK_BASE_URL=http://192.168.31.9:8083
CONNECTOR_DATA_DIR=/srv/data
# 可选：家族 Bark 推送 key，留空则不发通知
BARK_KEY=
